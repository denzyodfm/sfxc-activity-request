# Copy to .env and fill in real values. Never commit .env.

# Database — MySQL/MariaDB
DATABASE_URL="mysql://user:password@127.0.0.1:3306/sfxc_activity_request"

# Session signing key — REQUIRED. The app will not start without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every active session.
SESSION_SECRET=""

# Set to true when serving over HTTPS (production).
SESSION_COOKIE_SECURE="false"

NEXT_PUBLIC_APP_NAME="SFXC Activity Request System"

# Shadow database for `prisma migrate dev` (development only).
SHADOW_DATABASE_URL="mysql://user:password@127.0.0.1:3306/sfxc_activity_request_shadow"
