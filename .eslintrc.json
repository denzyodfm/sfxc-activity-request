{
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "backups/",
    "private/",
    "public/",
    "prisma/migrations/"
  ],
  "rules": {
    "eqeqeq": ["error", "smart"],
    "no-console": "off",
    "no-unused-vars": "off",
    "prefer-const": "error",
    "no-var": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.js", "prisma/seed.js"],
      "env": { "node": true, "commonjs": true },
      "rules": {
        "@next/next/no-assign-module-variable": "off"
      }
    }
  ]
}
