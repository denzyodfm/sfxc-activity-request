generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  passwordHash      String?
  firstName         String?
  middleName        String?
  lastName          String?
  birthdate         DateTime?
  position          String?
  profilePictureUrl String?
  role              String
  isDepartmentHead  Boolean           @default(false)
  /// Deactivated accounts cannot sign in and their live sessions stop
  /// resolving. Used instead of deletion, which is blocked once a user has
  /// request history.
  isActive          Boolean           @default(true)
  /// Bumped to invalidate every session token already issued to this user.
  /// See lib/session-token.ts.
  tokenVersion      Int               @default(0)
  failedLoginCount  Int               @default(0)
  lockedUntil       DateTime?
  department        Department?       @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  departmentId      String?
  headedDepartment  Department?       @relation("DepartmentHead")
  approvedRequests  ActivityRequest[] @relation("ApprovedBy")
  requests          ActivityRequest[] @relation("RequestedBy")
  approvals         RequestApproval[]
  auditLogs         AuditLog[]
  fundLedgerEntries FundLedgerEntry[]
  createdAt         DateTime          @default(now())
}

model Department {
  id        String            @id @default(cuid())
  name      String            @unique
  head      User?             @relation("DepartmentHead", fields: [headId], references: [id])
  headId    String?           @unique
  employees User[]            @relation("DepartmentEmployees")
  requests  ActivityRequest[]
}

model FundSource {
  id            String            @id @default(cuid())
  name          String            @unique
  description   String?
  parent        FundSource?       @relation("FundSubAccounts", fields: [parentId], references: [id])
  parentId      String?
  subAccounts   FundSource[]      @relation("FundSubAccounts")
  requests      ActivityRequest[]
  ledgerEntries FundLedgerEntry[]

  @@index([parentId])
}

model ActivityRequest {
  id                      String              @id @default(cuid())
  controlNumber           String              @unique
  date                    DateTime
  department              Department          @relation(fields: [departmentId], references: [id])
  departmentId            String
  requestedBy             User                @relation("RequestedBy", fields: [requestedById], references: [id])
  requestedById           String
  particulars             String
  preApprovalNotes        String?
  amount                  Decimal
  fundSource              FundSource?         @relation(fields: [fundSourceId], references: [id])
  fundSourceId            String?
  attachments             RequestAttachment[]
  approvals               RequestApproval[]
  auditLogs               AuditLog[]
  fundLedgerEntries       FundLedgerEntry[]
  status                  String              @default("DRAFT")
  fundAvailable           Boolean?
  fundAvailabilityRemarks String?
  reviewRemarks           String?
  endorsementRemarks      String?
  approvalRemarks         String?
  finalApprover           String?
  voucherPayTo            String?
  voucherAddress          String?
  voucherNumber           String?
  voucherParticulars      String?
  approvedBy              User?               @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedById            String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  // Every workflow queue filters on status and orders by date; the dashboard
  // and department views order by createdAt. MySQL already indexes the foreign
  // key columns, so only these are missing.
  @@index([status, date])
  @@index([status])
  @@index([createdAt])
}

model FundLedgerEntry {
  id              String           @id @default(cuid())
  fundSource      FundSource       @relation(fields: [fundSourceId], references: [id])
  fundSourceId    String
  request         ActivityRequest? @relation(fields: [requestId], references: [id])
  requestId       String?
  actor           User?            @relation(fields: [actorId], references: [id])
  actorId         String?
  type            String
  description     String
  reference       String?
  transactionDate DateTime         @default(now())
  debit           Decimal          @default(0)
  credit          Decimal          @default(0)
  balanceAfter    Decimal
  createdAt       DateTime         @default(now())

  // getFundSourceBalance() reads the newest row for one fund on every balance
  // check and every ledger write.
  @@index([fundSourceId, createdAt])
}

model RequestAttachment {
  id        String          @id @default(cuid())
  request   ActivityRequest @relation(fields: [requestId], references: [id])
  requestId String
  fileName  String
  fileUrl   String
  createdAt DateTime        @default(now())
}

model RequestApproval {
  id           String          @id @default(cuid())
  request      ActivityRequest @relation(fields: [requestId], references: [id])
  requestId    String
  actor        User            @relation(fields: [actorId], references: [id])
  actorId      String
  role         String
  action       String
  approvalCode String?         @unique
  remarks      String?
  createdAt    DateTime        @default(now())
}

model AuditLog {
  id        String           @id @default(cuid())
  request   ActivityRequest? @relation(fields: [requestId], references: [id])
  requestId String?
  user      User?            @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  details   String?
  createdAt DateTime         @default(now())

  @@index([createdAt])
}

model VoucherSignatory {
  id        String   @id @default(cuid())
  slot      String   @unique
  name      String
  title     String?
  updatedAt DateTime @updatedAt
}

/// Editable site-wide settings, keyed by a dotted name (see lib/branding.ts).
/// Values fall back to code defaults when a row is absent, so a fresh database
/// needs no seeding.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
